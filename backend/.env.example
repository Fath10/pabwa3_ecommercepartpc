# PostgreSQL connection string (e.g. a Neon/Supabase/local Postgres URL)
DATABASE_URL='postgresql://user:password@host/dbname?sslmode=require'

# Port the API listens on
PORT=3000

# Secret used to sign/verify JWT access tokens. Use a long random string.
JWT_SECRET=change_me_to_a_long_random_secret

# Comma-separated list of frontend origins allowed by CORS.
CLIENT_URL=http://localhost:5173

# --- Optional: AI chat (Ollama). Only needed for the /api/chat-ai feature. ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# --- Optional: Custom SMTP (Email) server for Forgot Password. If empty, falls back to Ethereal. ---
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your_email@gmail.com
# SMTP_PASS=your_app_password
# SMTP_FROM="e-BuildPC Support" <your_email@gmail.com>

